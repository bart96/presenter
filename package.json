{
  "name": "presenter",
  "version": "2.0.5",
  "description": "Presentation of songs, media and notes",
  "main": "./out/main/index.js",
  "author": "Marcel Birkholz",
  "homepage": "https://github.com/fbgg-de/Presenter",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "workspaces": [
    "ws-server"
  ],
  "scripts": {
    "start": "electron-vite preview",
    "dev": "concurrently -k -n \"i18n,frontend,backend\" -c \"yellow.bold,cyan.bold,magenta.bold\" \"typesafe-i18n\" \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "electron-vite dev --mode dev",
    "dev:backend": "php -S localhost:8000 dev-router.php",
    "dev:web": "vite dev --config vite.config.ts",
    "dev:mock": "node test/mock-backend/server.mjs",
    "dev:web:mock": "concurrently -k -n \"mock,web\" -c \"magenta.bold,cyan.bold\" \"npm:dev:mock\" \"npm:dev:web\"",
    "dev:mixer-bridge": "node test/mixer/fake-bridge.mjs",
    "test:ws": "node test/ws-sync/run.mjs",
    "test:ws-monitor": "node test/ws-monitor/run.mjs",
    "test:ws:bundle": "node scripts/test-ws-bundle.mjs",
    "test:screens": "node test/viewport/run.mjs",
    "test:lyrics": "node test/lyrics/run.mjs",
    "test:timeformat": "node test/timeformat/run.mjs",
    "test:stage": "node test/stage/run.mjs",
    "test:mixer": "node test/mixer/run.mjs",
    "test:shutdown": "node test/shutdown/run.mjs",
    "test:noise": "node test/error-noise/run.mjs",
    "test:styles": "node test/styles/run.mjs",
    "build": "npm run typesafe-i18n && npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:web": "npm run typesafe-i18n && vite build --config vite.config.ts",
    "build:web:dev": "node scripts/build-dev-web.mjs",
    "postinstall": "electron-builder install-app-deps",
    "publish": "node scripts/publish-all.mjs",
    "publish:artifacts": "node scripts/publish-artifacts.cjs",
    "publish:win": "npm run build && electron-builder --win --publish=always",
    "publish:mac": "npm run build && electron-builder --mac --publish=always",
    "format": "prettier --write .",
    "format:backend": "php php-cs-fixer.phar fix . --rules=@PSR12 --using-cache=no",
    "format:all": "npm run format:backend && npm run format",
    "lint": "eslint --cache .",
    "typesafe-i18n": "typesafe-i18n --no-watch",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "reinstall-electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-router-dom": "^5.3.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "font-list": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "prettier": "^3.9.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "typesafe-i18n": "^5.27.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "ws": "^8.21.3"
  }
}
